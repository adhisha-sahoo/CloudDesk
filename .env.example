# Run `python scripts/bootstrap.py` to create .env with unique local credentials.
CLOUDDESK_REQUESTER_TOKEN=
CLOUDDESK_APPROVER_TOKEN=
CLOUDDESK_BRIDGE_TOKEN=
CLOUDDESK_DATA_DIR=.data
CLOUDDESK_EMBEDDED_MOTO=true
CLOUDDESK_AWS_ENDPOINT=http://127.0.0.1:5000
# api, terraform, or jenkins. All three target the local emulator exclusively.
CLOUDDESK_EXECUTOR=api
CLOUDDESK_TERRAFORM_BIN=terraform
CLOUDDESK_JENKINS_URL=http://127.0.0.1:8080
CLOUDDESK_JENKINS_USER=admin
CLOUDDESK_JENKINS_TOKEN=
CLOUDDESK_JENKINS_JOB=clouddesk
CLOUDDESK_SLACK_BOT_TOKEN=
CLOUDDESK_SLACK_APP_TOKEN=
CLOUDDESK_SLACK_SIGNING_SECRET=
CLOUDDESK_SLACK_TEAM_ID=
# Comma-separated real Slack user IDs, never display names.
CLOUDDESK_SLACK_APPROVERS=
CLOUDDESK_SLACK_APPROVAL_CHANNEL=
# extractive always works without a model. ollama uses only local inference.
CLOUDDESK_ASSISTANT_MODE=extractive
CLOUDDESK_OLLAMA_URL=http://127.0.0.1:11434
CLOUDDESK_OLLAMA_MODEL=qwen2.5:1.5b
# Optional, user-provided ServiceNow developer instance; disabled by default.
CLOUDDESK_SERVICENOW_URL=
CLOUDDESK_SERVICENOW_USER=
CLOUDDESK_SERVICENOW_PASSWORD=
# Docker Jenkins setup only. Generated by bootstrap, not committed.
JENKINS_ADMIN_PASSWORD=
